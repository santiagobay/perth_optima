DATA_DIR=./data

# Opcional: si quieres conectar un dataset real externo de Perth, pon una URL CSV
# DATA_SOURCE_URL=https://example.com/perth_properties.csv

# Tamaño máximo de la instancia que se resuelve con el modelo exacto MTZ.
# MAX_EXACT_HOUSES=15

# Orígenes permitidos por CORS. En producción, apunta al dominio del frontend.
# CORS_ORIGINS=https://tu-app.vercel.app

# Modo debug de Flask. Déjalo en 0 fuera de tu máquina: expone una consola
# interactiva que permite ejecutar código arbitrario en el servidor.
FLASK_DEBUG=0
